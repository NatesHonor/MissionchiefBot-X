# Bot
MISSIONCHIEF_VERSION=3.0.2
MISSIONCHIEF_REGION=UK

# Web UI
MISSIONCHIEF_WEBUI_ENABLED=false
MISSIONCHIEF_WEBUI_HOST=127.0.0.1
MISSIONCHIEF_WEBUI_PORT=8765
# Compose publishes the WebUI to this host address. Keep 127.0.0.1 unless
# access from other devices is intentional and protected by a firewall.
MISSIONCHIEF_WEBUI_BIND=127.0.0.1

# Logging
MISSIONCHIEF_LOG_LEVEL=INFO
MISSIONCHIEF_LOG_CONSOLE=true
MISSIONCHIEF_LOG_FILE_ENABLED=true
MISSIONCHIEF_LOG_RICH_CONSOLE=true
# Folder for latest.log (this run) and MM-DD-YYYY.log (every run that day).
MISSIONCHIEF_LOG_DIR=logs

# Credentials
MISSIONCHIEF_USERNAME=
MISSIONCHIEF_PASSWORD=

# Browser
MISSIONCHIEF_HEADLESS=true
MISSIONCHIEF_BROWSERS=3
MISSIONCHIEF_BROWSER_SCALING=false

# Missions
MISSIONCHIEF_DISPATCH=Default
MISSIONCHIEF_DISPATCH_CONCURRENT_MISSIONS=true
MISSIONCHIEF_DISPATCH_INCOMPLETE_MISSIONS=false
MISSIONCHIEF_DISPATCH_VEHICLES_BY_DISTANCE=false
MISSIONCHIEF_DYNAMIC_MISSIONS=false
MISSIONCHIEF_INCLUDE_ALLIANCE_MISSIONS=true
MISSIONCHIEF_MAX_MISSIONS=500

# Other automation
MISSIONCHIEF_AUTO_TRAINING=false
MISSIONCHIEF_AUTO_RECRUITING=false
MISSIONCHIEF_AUTO_SPECIAL_RESOURCES=false
MISSIONCHIEF_AUTO_TASKS=false

# Delays
MISSIONCHIEF_DYNAMIC_DELAYS=false
MISSIONCHIEF_DYNAMIC_DELAY_MISSIONS=false
MISSIONCHIEF_DYNAMIC_DELAY_TRANSPORT=false
MISSIONCHIEF_MISSION_DELAY=30
MISSIONCHIEF_OTHER_DELAY=60
MISSIONCHIEF_DISPATCH_DELAY=0

# Training
MISSIONCHIEF_TRAINING_PLANS=[{"school":"Fire School","course":"all","rooms":1}]

# Recruiting
MISSIONCHIEF_RECRUITING_DAYS=1
