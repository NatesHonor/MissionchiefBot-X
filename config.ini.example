; Copy this file to config.ini for local use, or provide the credential
; environment variables listed in .env.example when running in Docker.
[bot]
version = 3.0.2
region = UK

[webui]
; When enabled, Main.py opens the local control page and waits for Start bot.
; When disabled, Main.py starts the bot directly as before.
enabled = false
host = 127.0.0.1
port = 8765

[credentials]
username =
password =

[browser_settings]
headless = true
browsers = 3
browser_scaling = false

[missions]
dispatch = Default
dispatch_concurrent_missions = true
dispatch_incomplete_missions = false
dispatch_vehicles_by_distance = false
dynamic_missions = false
include_alliance_missions = true
; Maximum active missions collected in one pass; set to 0 for unlimited.
max_missions = 500

[other]
auto_training = false
auto_recruiting = false
auto_special_resources = false
auto_tasks = false

[delays]
dynamic_delays = false
dynamic_missions = false
dynamic_transport = false
missions = 30
other = 60

[trainings]
[trainings.fire_school]
school = Fire School
training = all
rooms = 1

[recruiting]
days = 1
